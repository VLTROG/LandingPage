<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bottone Glassmorphism</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 200vh;
            background-color: grey;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .button-container {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 100;
        }

        .content {
            height: 200vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 18px;
            line-height: 1.6;
        }

        .content-block {
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            margin: 20px 0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-button {
            position: relative;
            padding: 16px 80px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            border-radius: 50px;
            border: none;
            outline: none;
            cursor: pointer;
            transition: all 0.3s ease;
            overflow: hidden;
            
            /* Ombra esterna bottom-right più vicina + ombra interna ridotta */
            box-shadow: 
                2px 4px 4px rgba(0, 0, 0, 0.21),         /* Ombra esterna bottom-right (-30% distanza) */
                inset 0 0 8px rgba(0, 0, 0, 0.175);      /* Ombra interna (-50% opacità) */
            
            /* Testo */
            color: rgba(255, 255, 255, 0.9);
            font-size: 16px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .glass-button::before {
            content: '';
            position: absolute;
            top: -0.5px;
            left: -0.5px;
            right: -0.5px;
            bottom: -0.5px;
            border-radius: 51px;
            padding: 1.5px;
            
            /* ===== BORDO BIANCO LUMINOSO - INIZIO ===== */
            /* Conic gradient che crea il riflesso luminoso sul bordo */
            background: conic-gradient(
                from 315deg at 35% 60%,                    /* Punto di partenza: angolo top-left */
                rgba(255, 255, 255, 0.85) 0deg,           /* Massima luminosità all'angolo */
                rgba(255, 255, 255, 0.7) 30deg,           /* Sfumatura iniziale */
                rgba(255, 255, 255, 0.4) 60deg,           /* Diminuzione graduale */
                rgba(255, 255, 255, 0.15) 90deg,          /* Quasi trasparente metà superiore */
                rgba(255, 255, 255, 0.05) 120deg,         /* Molto trasparente lato destro */
                rgba(255, 255, 255, 0.35) 150deg,         /* Trasparente lato destro/basso */
                rgba(255, 255, 255, 0.35) 120deg,         /* Trasparente lato inferiore */
                rgba(255, 255, 255, 0.02) 210deg,         /* Trasparente angolo bottom-left */
                rgba(255, 255, 255, 0.02) 240deg,         /* Leggero accenno lato sinistro */
                rgba(255, 255, 255, 0.02) 270deg,         /* Aumento graduale lato sinistro */
                rgba(255, 255, 255, 0.02) 300deg,          /* Intensificazione verso l'angolo */
                rgba(255, 255, 255, 0.7) 330deg,          /* Ritorno verso massima luminosità */
                rgba(255, 255, 255, 0.85) 360deg          /* Chiusura del ciclo */
            );
            /* Mask per limitare il gradiente solo al bordo (1.5px di spessore) */
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask-composite: xor;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            /* ===== BORDO BIANCO LUMINOSO - FINE ===== */
            
            /* Anti-aliasing migliorato */
            will-change: transform;
            transform: translateZ(0);
            -webkit-transform: translateZ(0);
        }

        .glass-button::after {
            content: '';
            position: absolute;
            top: 1px;
            left: 1px;
            right: 1px;
            bottom: 1px;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(16px) saturate(160%) brightness(110%);
            -webkit-backdrop-filter: blur(16px) saturate(160%) brightness(110%);
            border-radius: 48.5px;
            z-index: -1;
            /* Anti-aliasing per bordi smooth */
            transform: translateZ(0);
            -webkit-transform: translateZ(0);
        }
        
    </style>
</head>
<body>
    
    <div class="button-container">
        <button class="glass-button">placeholder</button>
    </div>

</body>
</html>