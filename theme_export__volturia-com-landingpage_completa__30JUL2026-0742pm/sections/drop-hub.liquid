    { "type":"text", "id":"nl_title", "label":"Newsletter title", "default":"Sign up and save" },
    { "type":"textarea", "id":"nl_text", "label":"Newsletter text", "default":"Let customers know about the key benefits of joining your newsletter." },
    { "type":"text", "id":"nl_footnote", "label":"Newsletter footnote", "default":"We never spam. Unsubscribe anytime." },
