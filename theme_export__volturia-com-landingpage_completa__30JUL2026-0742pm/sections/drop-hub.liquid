{% liquid
  assign title_text = section.settings.title
  assign subtitle_text = section.settings.subtitle
  assign drop_name = section.settings.drop_name
  assign desc_text = section.settings.description

  capture target_str
    echo section.settings.year
    echo '-'
    echo section.settings.month
    echo '-'
    echo section.settings.day
    echo ' '
    echo section.settings.hour
    echo ':'
    echo section.settings.minute
    echo ':00'
  endcapture

  assign target_unix = target_str | date: '%s'
  assign now_unix = 'now' | date: '%s'
  assign is_live = false
  if now_unix >= target_unix
    assign is_live = true
  endif
%}

<section id="DropHub-{{ section.id }}" class="drop-hub">
  <div class="dh-wrap dh-wrap--{{ section.settings.window_align | default: 'center' }}">
  <div class="dh-window">
    <div class="dh-reflection dh-reflection--top" aria-hidden="true"></div>

    <div class="dh-block dh-calendar" data-live="{{ is_live }}">
      <header class="dh-cal__header">
        {% if title_text != blank %}
          <h2 class="dh-title">{{ title_text | upcase }}</h2>
        {% endif %}
        {% if subtitle_text != blank %}
          <p class="dh-subtitle">{{ subtitle_text }}</p>
        {% endif %}
      </header>
      {% if drop_name != blank %}
        <div class="dh-status" data-status>
          <span class="dot"></span>
          <span class="label">DROP {% if is_live %}NOW LIVE{% else %}COMING SOON{% endif %}{% if drop_name != blank %}: ‘{{ drop_name }}’{% endif %}</span>
        </div>
      {% endif %}
      {% if desc_text != blank %}
        <p class="dh-desc">{{ desc_text }}</p>
      {% endif %}

      <div class="dh-timer" data-timer
        data-year="{{ section.settings.year }}"
        data-month="{{ section.settings.month }}"
        data-day="{{ section.settings.day }}"
        data-hour="{{ section.settings.hour }}"
        data-minute="{{ section.settings.minute }}">
        <div class="tblock"><div class="num" data-dd>00</div><div class="unit">DAYS</div></div>
        <div class="tblock"><div class="num" data-hh>00</div><div class="unit">HOURS</div></div>
        <div class="tblock"><div class="num" data-mm>00</div><div class="unit">MINUTES</div></div>
        <div class="tblock"><div class="num" data-ss>00</div><div class="unit">SECONDS</div></div>
      </div>

      <div class="dh-cta dh-cta--{{ section.settings.button_align | default: 'center' }}">
        {% if is_live %}
          <a class="btn btn--enter" href="{{ section.settings.enter_url }}" data-enter-btn>
            <span class="btn__label">Enter the Drop</span>
          </a>
        {% else %}
          <a class="btn btn--enter is-locked" data-enter-btn>
            <span class="btn__label">Enter the Drop</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="dh-sep" aria-hidden="true"></div>

    <div class="dh-block dh-newsletter">
      {% if section.settings.nl_title != blank %}
        <h3 class="nl-title">{{ section.settings.nl_title }}</h3>
      {% endif %}
      {% if section.settings.nl_text != blank %}
        <p class="nl-text">{{ section.settings.nl_text }}</p>
      {% endif %}
      <div class="nl-form">
        {%- render 'newsletter-form', section_id: section.id, snippet_context: 'section' -%}
      </div>
      {% if section.settings.nl_footnote != blank %}
        <p class="nl-footnote" style="color: {{ section.settings.nl_footnote_color }}">{{ section.settings.nl_footnote }}</p>
      {% endif %}
    </div>

    <div class="dh-reflection dh-reflection--bottom" aria-hidden="true"></div>
  </div>
  </div>

  {% style %}
    @media only screen and (min-width: 769px) {
      /* Padding verticale della sezione, uguale a window-cta (solo desktop) */
      #DropHub-{{ section.id }} { padding: clamp(20px, 5vw, 60px) 0; }
      /* Two-column viewport: window centered in chosen half (left/right), or full center */
      #DropHub-{{ section.id }} .dh-wrap{ display:grid; grid-template-columns: 1fr 1fr; }
      #DropHub-{{ section.id }} .dh-wrap--center{ grid-template-columns: 1fr; justify-items: center; }
      #DropHub-{{ section.id }} .dh-wrap--left .dh-window{ grid-column: 1; justify-self: center; }
      #DropHub-{{ section.id }} .dh-wrap--right .dh-window{ grid-column: 2; justify-self: center; }

      #DropHub-{{ section.id }} .dh-window{
        position:relative; width: min(36.8vw, 576px); margin:0; padding:34px; border-radius:50px; overflow:hidden;
        /* Allinea il padding verticale alla card di window-cta */
        padding-top: clamp(20px, 5vw, 40px);
        padding-bottom: clamp(20px, 5vw, 40px);
        background:rgba(255,255,255,.08); backdrop-filter:blur(12px);
        border:1px solid rgba(255,255,255,.8);
        box-shadow:0 24px 60px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.35);
      }
      #DropHub-{{ section.id }} .dh-reflection{ position:absolute; left:0; right:0; height:18px; pointer-events:none; }
      #DropHub-{{ section.id }} .dh-reflection--top{ top:0; border-top-left-radius:50px; border-top-right-radius:50px; background:linear-gradient(180deg, rgba(255,255,255,.35), rgba(255,255,255,0)); }
      #DropHub-{{ section.id }} .dh-reflection--bottom{ bottom:0; border-bottom-left-radius:50px; border-bottom-right-radius:50px; background:linear-gradient(0deg, rgba(255,255,255,.2), rgba(255,255,255,0)); }

      /* Aumenta spaziatura sopra e sotto l'interlinea del 50% */
      #DropHub-{{ section.id }} .dh-block + .dh-sep{ margin:54px 0; }
      #DropHub-{{ section.id }} .dh-sep{ height:2px; background:linear-gradient(90deg, rgba(255,255,255,0), #fff, rgba(255,255,255,0)); opacity:.8; }

      #DropHub-{{ section.id }} .dh-title{ text-align:center; margin:0 0 10px; font-weight:800; letter-spacing:.06em; }
      #DropHub-{{ section.id }} .dh-subtitle{ text-align:center; margin:0 0 16px; color:#9aa0a6; }
      #DropHub-{{ section.id }} .dh-desc{ text-align:center; margin:10px 0 22px; opacity:.9; }
      #DropHub-{{ section.id }} .dh-calendar, #DropHub-{{ section.id }} .dh-newsletter { display:flex; flex-direction:column; align-items:center; }
      /* Centra verticalmente l'insieme dei blocchi rispetto ai bordi top/bottom della window */
      #DropHub-{{ section.id }} .dh-window{ display:flex; flex-direction:column; justify-content:center; }
      #DropHub-{{ section.id }} .dh-status{ display:flex; align-items:center; justify-content:center; gap:8px; margin:10px 0; }
      #DropHub-{{ section.id }} .dh-status .dot{ width:10px; height:10px; border-radius:50%; background:#00e5ff; box-shadow:0 0 8px rgba(0,229,255,.6); }
      #DropHub-{{ section.id }} .dh-status .label{ font-weight:700; letter-spacing:.04em; }

      #DropHub-{{ section.id }} .dh-timer{ display:flex; justify-content:center; gap:14px; flex-wrap:wrap; margin:16px 0 26px; }
      #DropHub-{{ section.id }} .tblock{ min-width:110px; border-radius:16px; border:1px solid rgba(255,255,255,.7); padding:14px 16px; text-align:center; backdrop-filter:blur(8px); background:rgba(255,255,255,.08); }
      #DropHub-{{ section.id }} .tblock .num{ font-size:28px; font-weight:800; transition:transform .2s ease, opacity .2s ease; }
      #DropHub-{{ section.id }} .tblock .unit{ font-size:12px; letter-spacing:.12em; opacity:.8; }

      #DropHub-{{ section.id }} .dh-cta{ display:flex; transform: translateY(12px); }
      #DropHub-{{ section.id }} .dh-cta--left{ justify-content:flex-start; }
      #DropHub-{{ section.id }} .dh-cta--center{ justify-content:center; }
      #DropHub-{{ section.id }} .dh-cta--right{ justify-content:flex-end; }
      #DropHub-{{ section.id }} .btn.btn--enter{ display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 20px; border-radius:16px; background:rgba(255,218,185,.4); color:#000; font-weight:700; text-transform:uppercase; letter-spacing:.06em; transition:transform .12s ease, opacity .2s ease, background .2s ease, box-shadow .2s ease, border-color .2s ease; border:1px solid rgba(255,218,185,.7); backdrop-filter:blur(10px); box-shadow:8px 10px 13px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.35); }
      #DropHub-{{ section.id }} .btn.btn--enter:active{ transform:scale(.97); }
      #DropHub-{{ section.id }} .btn.btn--enter.is-locked{ cursor:not-allowed; position:relative; }
      #DropHub-{{ section.id }} .btn.btn--enter.is-locked .btn__label{ transition:opacity .2s ease; }
      #DropHub-{{ section.id }} .btn.btn--enter.is-locked:hover .btn__label{ opacity:0; }
      #DropHub-{{ section.id }} .btn.btn--enter.is-locked::after{ content:'locked'; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); opacity:0; transition:opacity .2s ease; font-size:12px; letter-spacing:.06em; }
      #DropHub-{{ section.id }} .btn.btn--enter.is-locked:hover::after{ opacity:1; }

      /* Aumenta le distanze interne della newsletter del 30% + ulteriore 20% richiesto */
      #DropHub-{{ section.id }} .nl-title{ text-align:center; margin:0 0 calc(10px * 1.2); font-weight:800; letter-spacing:.04em; }
      #DropHub-{{ section.id }} .nl-text{ text-align:center; margin:0 0 calc(16px * 1.2); opacity:.9; }
      #DropHub-{{ section.id }} .nl-form{ display:flex; justify-content:center; margin:0 0 calc(16px * 1.2); }
      #DropHub-{{ section.id }} .nl-form form{ display:flex; gap:10px; width:100%; max-width:1500px; margin:0 auto; }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group{ display:flex; gap:10px; width:100%; }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group__input,
      #DropHub-{{ section.id }} .nl-form form input[type="email"]{ flex:1 1 0%; width:100%; min-width:0; border-radius:14px; border:1px solid rgba(255,255,255,.6); background:rgba(255,255,255,.1); color:inherit; padding:10px 12px; }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group__submit{ flex:0 0 56px; height:42px; border-radius:14px; border:1px solid rgba(255,255,255,.6); background:#fff; color:#000; font-weight:700; cursor:pointer; transition:transform .12s ease; display:inline-flex; align-items:center; justify-content:center; }
      #DropHub-{{ section.id }} .nl-form form input[type="email"]{ transition:border-color .2s ease, box-shadow .2s ease, background .2s ease; }
      #DropHub-{{ section.id }} .nl-form form input[type="email"]:focus, 
      #DropHub-{{ section.id }} .nl-form form input[type="email"]:focus-visible{ outline:none; border-color:rgba(255,255,255,.9); box-shadow:0 0 0 2px rgba(255,255,255,.65), 0 8px 20px rgba(0,0,0,.18); background:rgba(255,255,255,.14); }
      #DropHub-{{ section.id }} .nl-form form .btn{ flex:0 0 48px; height:42px; border-radius:14px; border:1px solid rgba(255,255,255,.6); background:#fff; color:#000; font-weight:700; cursor:pointer; transition:transform .12s ease; display:inline-flex; align-items:center; justify-content:center; }
      /* Re-style email icon as decorative overlay inside the input (desktop only) */
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group{ position:relative; }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group__input{ padding-right:48px; }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group__submit{
        position:absolute; right:10px; top:50%; transform:translateY(-50%);
        width:28px; height:28px; padding:0; flex:0 0 auto;
        background:transparent; border:0; box-shadow:none; pointer-events:none;
        display:flex; align-items:center; justify-content:center;
      }
      #DropHub-{{ section.id }} .nl-form form .newsletter-form-group__submit .icon{ width:22px; height:22px; }
      #DropHub-{{ section.id }} .nl-form .btn:active{ transform:scale(.97); }
      #DropHub-{{ section.id }} .nl-footnote{ text-align:center; margin-top: calc(10px * 1.2); font-size:13px; opacity:.9; }
    }
  {% endstyle %}

  <script>
    (function(){
      var root = document.getElementById('DropHub-{{ section.id }}');
      if(!root) return;
      var wrap = root.querySelector('.dh-calendar');
      var timer = root.querySelector('[data-timer]');
      var btn = root.querySelector('[data-enter-btn]');
      var status = root.querySelector('[data-status] .label');
      var live = wrap.getAttribute('data-live') === 'true';

      function setNums(d,h,m,s){
        root.querySelector('[data-dd]').textContent = (d<10? ('0'+d): d);
        root.querySelector('[data-hh]').textContent = ('0'+h).slice(-2);
        root.querySelector('[data-mm]').textContent = ('0'+m).slice(-2);
        root.querySelector('[data-ss]').textContent = ('0'+s).slice(-2);
      }
      setNums(0,0,0,0);

      var Y = parseInt(timer.getAttribute('data-year'),10);
      var Mo = parseInt(timer.getAttribute('data-month'),10)-1;
      var D = parseInt(timer.getAttribute('data-day'),10);
      var H = parseInt(timer.getAttribute('data-hour'),10);
      var Mi = parseInt(timer.getAttribute('data-minute'),10);
      var target = new Date(Y,Mo,D,H,Mi,0).getTime();

      function unlock(){
        if(btn && btn.classList.contains('is-locked')){
          btn.classList.remove('is-locked');
          btn.setAttribute('href', {{ section.settings.enter_url | json }});
          if(status){ status.textContent = "DROP NOW LIVE: ‘{{ drop_name }}’"; }
        }
      }

      if(live){ unlock(); }
      else{
        var iv = setInterval(function(){
          var now = Date.now();
          var diff = Math.max(0, target - now);
          var d = Math.floor(diff/86400000);
          var h = Math.floor((diff%86400000)/3600000);
          var m = Math.floor((diff%3600000)/60000);
          var s = Math.floor((diff%60000)/1000);
          setNums(d,h,m,s);
          if(diff <= 0){ clearInterval(iv); setNums(0,0,0,0); unlock(); }
        }, 1000);
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Drop Hub",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "DROPS CALENDAR" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Upcoming releases and priority access" },
    { "type": "text", "id": "drop_name", "label": "Drop name", "default": "MIDNIGHT" },
    { "type": "text", "id": "description", "label": "Description", "default": "The collection is available for a limited time" },
    { "type": "url", "id": "enter_url", "label": "Enter drop URL" },
    { "type": "select", "id": "button_align", "label": "Button alignment", "default": "center", "options": [
      {"value":"left","label":"Left"}, {"value":"center","label":"Center"}, {"value":"right","label":"Right"}
    ] },
    { "type": "select", "id": "window_align", "label": "Window alignment (desktop)", "default": "center", "options": [
      {"value":"left","label":"Left half"}, {"value":"center","label":"Center"}, {"value":"right","label":"Right half"}
    ] },
    { "type": "header", "content": "End date/time" },
    { "type": "select", "id": "year", "label": "Year", "default": "2025", "options": [ {"value":"2025","label":"2025"}, {"value":"2026","label":"2026"} ] },
    { "type": "select", "id": "month", "label": "Month", "default": "01", "options": [
      {"value":"01","label":"01"},{"value":"02","label":"02"},{"value":"03","label":"03"},{"value":"04","label":"04"},{"value":"05","label":"05"},{"value":"06","label":"06"},{"value":"07","label":"07"},{"value":"08","label":"08"},{"value":"09","label":"09"},{"value":"10","label":"10"},{"value":"11","label":"11"},{"value":"12","label":"12"}
    ] },
    { "type": "select", "id": "day", "label": "Day", "default": "1", "options": [
      {"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"},{"value":"6","label":"6"},{"value":"7","label":"7"},{"value":"8","label":"8"},{"value":"9","label":"9"},{"value":"10","label":"10"},{"value":"11","label":"11"},{"value":"12","label":"12"},{"value":"13","label":"13"},{"value":"14","label":"14"},{"value":"15","label":"15"},{"value":"16","label":"16"},{"value":"17","label":"17"},{"value":"18","label":"18"},{"value":"19","label":"19"},{"value":"20","label":"20"},{"value":"21","label":"21"},{"value":"22","label":"22"},{"value":"23","label":"23"},{"value":"24","label":"24"},{"value":"25","label":"25"},{"value":"26","label":"26"},{"value":"27","label":"27"},{"value":"28","label":"28"},{"value":"29","label":"29"},{"value":"30","label":"30"},{"value":"31","label":"31"}
    ] },
    { "type": "select", "id": "hour", "label": "Hour (24h)", "default": "00", "options": [
      {"value":"00","label":"00"},{"value":"01","label":"01"},{"value":"02","label":"02"},{"value":"03","label":"03"},{"value":"04","label":"04"},{"value":"05","label":"05"},{"value":"06","label":"06"},{"value":"07","label":"07"},{"value":"08","label":"08"},{"value":"09","label":"09"},{"value":"10","label":"10"},{"value":"11","label":"11"},{"value":"12","label":"12"},{"value":"13","label":"13"},{"value":"14","label":"14"},{"value":"15","label":"15"},{"value":"16","label":"16"},{"value":"17","label":"17"},{"value":"18","label":"18"},{"value":"19","label":"19"},{"value":"20","label":"20"},{"value":"21","label":"21"},{"value":"22","label":"22"},{"value":"23","label":"23"}
