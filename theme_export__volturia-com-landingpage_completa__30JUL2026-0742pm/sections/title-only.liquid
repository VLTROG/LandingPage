<div class="index-section title-only-section title-only-{{ section.id }}">
  <div class="page-width">
    {% style %}
      .title-only-{{ section.id }}{ padding-top: clamp(6px, 1.5vw, 14px); padding-bottom: clamp(6px, 1.5vw, 14px); }
      .title-only-{{ section.id }} .to-eyebrow{ text-align:center; margin:0 0 8px; opacity:.8; font-family: 'PPNeueMontreal', sans-serif !important; letter-spacing:.06em; will-change: opacity, transform; opacity: 0; transform: translateY(18px); animation: toFadeUp-{{ section.id }} .55s ease forwards; animation-delay: .06s; }
      .title-only-{{ section.id }} .to-title{ text-align:center; margin:0; line-height:1.1; font-family: 'PPNeueMontrealTitoli', sans-serif !important; font-weight: 0 !important; letter-spacing: -0.05rem; color: {{ section.settings.title_color | default: '#212121' }}; will-change: opacity, transform; opacity: 0; transform: translateY(18px); animation: toFadeUp-{{ section.id }} .55s ease forwards; animation-delay: .08s; }
      .title-only-{{ section.id }} .to-subtitle{ text-align:center; margin:10px 0 0; opacity:.8; font-family: 'PPNeueMontreal', sans-serif !important; color: {{ section.settings.subtitle_color | default: '#393939' }}; will-change: opacity, transform; opacity: 0; transform: translateY(18px); animation: toFadeUp-{{ section.id }} .55s ease forwards; animation-delay: .1s; }
      .title-only-{{ section.id }} .to-media{ margin-top: 14px; will-change: opacity, transform; opacity: 0; transform: translateY(18px); animation: toFadeUp-{{ section.id }} .55s ease forwards; animation-delay: .12s; }
      .title-only-{{ section.id }} .to-media-frame{ position:relative; width:100%; aspect-ratio: 21 / 9; border-radius:50px; overflow:hidden; background: rgba(255,255,255,0.06); box-shadow: 4px 8px 8px rgba(0, 0, 0, 0.18); }
      .title-only-{{ section.id }} .to-media-frame > video,
      .title-only-{{ section.id }} .to-media-frame > img{ width:100%; height:100%; object-fit:cover; display:block; }
      @media (max-width: 768px) {
        .title-only-{{ section.id }} .to-eyebrow{ font-size: {{ section.settings.eyebrow_size_mobile | default: 14 }}px; }
        .title-only-{{ section.id }} .to-title{ font-size: {{ section.settings.title_size_mobile | default: 36 }}px; }
        .title-only-{{ section.id }} .to-subtitle{ font-size: {{ section.settings.subtitle_size_mobile | default: 16 }}px; line-height: 1.5; }
        .title-only-{{ section.id }} .to-media-frame{ aspect-ratio: 16 / 9; }
      }
      @media (min-width: 769px) {
        .title-only-{{ section.id }} .to-eyebrow{ font-size: {{ section.settings.eyebrow_size_desktop | default: 16 }}px; }
        .title-only-{{ section.id }} .to-title{ font-size: {{ section.settings.title_size_desktop | default: 64 }}px; }
        .title-only-{{ section.id }} .to-subtitle{ font-size: {{ section.settings.subtitle_size_desktop | default: 20 }}px; line-height: 1.6; }
        /* Ingrandimento del 30% del contenitore immagine (solo desktop) con responsive fluida e margini laterali */
        .title-only-{{ section.id }} .to-media{ display: block; position: relative; --to-scale: 1.3; overflow: visible; max-width: min(100%, 70vw); margin-left: auto; margin-right: auto; }
        /* Pseudo-elemento per riservare spazio verticale: aspect 21/9 scalato del 30% */
        .title-only-{{ section.id }} .to-media::before{ content:''; display:block; padding-top: calc((9 / 21) * 100% * var(--to-scale)); }
        .title-only-{{ section.id }} .to-media-frame{ position: absolute; left: 50%; top: 0; transform: translateX(-50%) scale(var(--to-scale)); transform-origin: top center; will-change: transform; }
      }
      @keyframes toFadeUp-{{ section.id }} {
        0% { opacity: 0; transform: translateY(18px); }
        100% { opacity: 1; transform: translateY(0); }
      }

      /* GSAP helpers: disattiva animazioni CSS testo quando GSAP è attivo */
      .title-only-{{ section.id }}.gsap-enabled .to-eyebrow,
      .title-only-{{ section.id }}.gsap-enabled .to-title,
      .title-only-{{ section.id }}.gsap-enabled .to-subtitle,
      .title-only-{{ section.id }}.gsap-enabled .to-media{ animation: none !important; }

      /* Stato iniziale per blur-to-focus (applicato da JS con .gsap-reveal) */
      .title-only-{{ section.id }} .gsap-reveal{
        filter: blur(10px);
        opacity: 0.9;
        transform: translateY(18px);
        will-change: opacity, transform, filter;
      }
    {% endstyle %}

    {% if section.settings.eyebrow_text != blank %}
      <div class="to-eyebrow">{{ section.settings.eyebrow_text }}</div>
    {% endif %}
    {% if section.settings.title_text != blank %}
      <h2 class="to-title">{{ section.settings.title_text }}</h2>
    {% endif %}
    {% if section.settings.subtitle_text != blank %}
      <p class="to-subtitle">{{ section.settings.subtitle_text }}</p>
    {% endif %}

    {% if section.settings.media_enable %}
      <div class="to-media">
        <div class="to-media-frame">
          {% if section.settings.media_type == 'video' and section.settings.media_source_url != blank %}
            <video src="{{ section.settings.media_source_url }}" autoplay muted loop playsinline></video>
          {% elsif section.settings.media_image != blank %}
            {{ section.settings.media_image | image_url: width: 2400 | image_tag: loading: 'lazy', decoding: 'async', alt: section.settings.media_alt }}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
(function(){
  try{
    var root = document.querySelector('.title-only-{{ section.id }}');
    if(!root) return;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function loadScript(src){
      return new Promise(function(resolve, reject){
        var s = document.createElement('script');
        s.src = src; s.async = true; s.onload = resolve; s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function init(){
      if (!window.gsap || !window.ScrollTrigger) return;
      gsap.registerPlugin(ScrollTrigger);

      // Abilita GSAP e stato iniziale sugli elementi di testo
      root.classList.add('gsap-enabled');
      var targets = [];
      var eyebrowEl = root.querySelector('.to-eyebrow');
      var titleEl = root.querySelector('.to-title');
      var subtitleEl = root.querySelector('.to-subtitle');
      var mediaEl = root.querySelector('.to-media');
      // Ordine progressivo: eyebrow -> title -> subtitle -> media (se presente)
      [eyebrowEl, titleEl, subtitleEl, mediaEl].forEach(function(el){ if(el) targets.push(el); });

      if (prefersReduced){
        targets.forEach(function(el){
          el.style.filter = 'none';
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
        return;
      }

      // Applica stato iniziale
      targets.forEach(function(el){ el.classList.add('gsap-reveal'); el.style.animation = 'none'; });

      // Anima ciascun elemento al suo ingresso in viewport (desktop e mobile)
      targets.forEach(function(el, i){
        gsap.to(el, {
          opacity: 1,
          filter: 'blur(0px)',
          y: 0,
          duration: 1.6,
          delay: 0,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 75%',
            toggleActions: 'play none none none',
            once: true
          }
        });
      });
    }

    if (window.gsap && window.ScrollTrigger){
      init();
    } else {
      var gsapUrl = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
      var stUrl = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js';
      loadScript(gsapUrl).then(function(){ return loadScript(stUrl); }).then(init).catch(function(){});
    }
  } catch(e){}
})();
</script>

{% schema %}
{
  "name": "Title only",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow (small heading)", "default": "MISSION" },
    { "type": "text", "id": "title_text", "label": "Title", "default": "Your title here" },
    { "type": "textarea", "id": "subtitle_text", "label": "Subtitle (description)", "default": "Add a short description that supports the headline." },
    { "type": "range", "id": "eyebrow_size_mobile", "label": "Eyebrow size (mobile, px)", "min": 10, "max": 40, "step": 2, "default": 14 },
    { "type": "range", "id": "eyebrow_size_desktop", "label": "Eyebrow size (desktop, px)", "min": 12, "max": 48, "step": 2, "default": 16 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size (mobile, px)", "min": 12, "max": 120, "step": 2, "default": 36 },
    { "type": "range", "id": "title_size_desktop", "label": "Title size (desktop, px)", "min": 16, "max": 160, "step": 2, "default": 64 },
    { "type": "range", "id": "subtitle_size_mobile", "label": "Subtitle size (mobile, px)", "min": 10, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Subtitle size (desktop, px)", "min": 12, "max": 48, "step": 2, "default": 20 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#212121" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#393939" },

    { "type": "header", "content": "Media" },
    { "type": "checkbox", "id": "media_enable", "label": "Show media below subtitle", "default": true },
    { "type": "select", "id": "media_type", "label": "Media type", "default": "video", "options": [
      { "value": "video", "label": "Video (MP4/WebM URL)" },
      { "value": "image", "label": "Image/GIF" }
    ] },
    { "type": "text", "id": "media_source_url", "label": "Video file URL (MP4/WebM). Upload in Files and paste URL.", "default": "https://example.com/video.mp4" },
    { "type": "image_picker", "id": "media_image", "label": "Image/GIF (optional)" },
    { "type": "text", "id": "media_alt", "label": "Media alt text", "default": "Section media" }
  ],
  "presets": [
    { "name": "Title only" }
  ]
}
{% endschema %}


