{% liquid
  assign title_text = section.settings.title | default: 'DROPS CALENDAR'
  assign subtitle_text = section.settings.subtitle | default: 'Upcoming releases and priority access'
  assign drop_name = section.settings.drop_name | default: 'MIDNIGHT'
  assign desc_text = section.settings.description | default: 'The collection is available for a limited time'

  capture target_str
    echo section.settings.year
    echo '-'
    echo section.settings.month
    echo '-'
    echo section.settings.day
    echo ' '
    echo section.settings.hour
    echo ':'
    echo section.settings.minute
    echo ':00'
  endcapture

  assign target_unix = target_str | date: '%s'
  assign now_unix = 'now' | date: '%s'
  assign is_live = false
  if now_unix >= target_unix
    assign is_live = true
  endif
%}

<section class="drop-cal-section" id="DropsCalendar-{{ section.id }}" data-section-type="drops-calendar">
  <div class="drop-cal" data-live="{{ is_live }}">
    <header class="drop-cal__header">
      <h2 class="drop-cal__title">{{ title_text | upcase }}</h2>
      <p class="drop-cal__subtitle">{{ subtitle_text }}</p>
    </header>

    <div class="drop-cal__status" data-status>
      <span class="dot" aria-hidden="true"></span>
      <span class="label">DROP {% if is_live %}NOW LIVE{% else %}COMING SOON{% endif %}: ‘{{ drop_name }}’</span>
    </div>

    <p class="drop-cal__desc">{{ desc_text }}</p>

    <div class="drop-cal__timer" data-timer
      data-year="{{ section.settings.year }}"
      data-month="{{ section.settings.month }}"
      data-day="{{ section.settings.day }}"
      data-hour="{{ section.settings.hour }}"
      data-minute="{{ section.settings.minute }}">
      <div class="tblock"><div class="num" data-dd>00</div><div class="unit">DAYS</div></div>
      <div class="tblock"><div class="num" data-hh>00</div><div class="unit">HOURS</div></div>
      <div class="tblock"><div class="num" data-mm>00</div><div class="unit">MINUTES</div></div>
      <div class="tblock"><div class="num" data-ss>00</div><div class="unit">SECONDS</div></div>
    </div>

    <div class="drop-cal__cta drop-cal__cta--{{ section.settings.button_align | default: 'center' }}">
      {% if is_live %}
        <a class="btn btn--enter" href="{{ section.settings.enter_url }}" data-enter-btn>
          <span class="btn__label">Enter the Drop</span>
        </a>
      {% else %}
        <a class="btn btn--enter is-locked" data-enter-btn>
          <span class="btn__label">Enter the Drop</span>
        </a>
      {% endif %}
    </div>
  </div>

  {% style %}
    #DropsCalendar-{{ section.id }} .drop-cal{
      border:1px solid #fff; border-color:#fff; background:transparent; border-radius:24px;
      padding:28px; max-width:980px; margin:0 auto;
    }
    #DropsCalendar-{{ section.id }} .drop-cal__header{ text-align:center; margin-bottom:10px; }
    #DropsCalendar-{{ section.id }} .drop-cal__title{ margin:0 0 6px; font-weight:800; letter-spacing:.06em; }
    #DropsCalendar-{{ section.id }} .drop-cal__subtitle{ margin:0; color:#9aa0a6; }
    #DropsCalendar-{{ section.id }} .drop-cal__status{ display:flex; align-items:center; justify-content:center; gap:8px; margin:16px 0 6px; }
    #DropsCalendar-{{ section.id }} .drop-cal__status .dot{ width:10px; height:10px; border-radius:50%; background:#00e5ff; box-shadow:0 0 8px rgba(0,229,255,.6); }
    #DropsCalendar-{{ section.id }} .drop-cal__status .label{ font-weight:700; letter-spacing:.04em; }
    #DropsCalendar-{{ section.id }} [data-live="false"] .drop-cal__status .label{ opacity:.9; }
    #DropsCalendar-{{ section.id }} .drop-cal__desc{ text-align:center; margin:0 0 16px; opacity:.9; }

    #DropsCalendar-{{ section.id }} .drop-cal__timer{ display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin:12px 0 20px; }
    #DropsCalendar-{{ section.id }} .tblock{ min-width:110px; border-radius:16px; border:1px solid rgba(255,255,255,.7); padding:14px 16px; text-align:center; backdrop-filter:blur(8px); background:rgba(255,255,255,.08); }
    #DropsCalendar-{{ section.id }} .tblock .num{ font-size:28px; font-weight:800; transition:transform .2s ease, opacity .2s ease; }
    #DropsCalendar-{{ section.id }} .tblock .unit{ font-size:12px; letter-spacing:.12em; opacity:.8; }

    #DropsCalendar-{{ section.id }} .drop-cal__cta{ display:flex; }
    #DropsCalendar-{{ section.id }} .drop-cal__cta--left{ justify-content:flex-start; }
    #DropsCalendar-{{ section.id }} .drop-cal__cta--center{ justify-content:center; }
    #DropsCalendar-{{ section.id }} .drop-cal__cta--right{ justify-content:flex-end; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter{ display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 20px; border-radius:16px; background:#fff; color:#000; font-weight:700; text-transform:uppercase; letter-spacing:.06em; transition:transform .12s ease, opacity .2s ease; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter:active{ transform:scale(.97); }
    #DropsCalendar-{{ section.id }} .btn.btn--enter.is-locked{ cursor:not-allowed; position:relative; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter.is-locked .btn__label{ transition:opacity .2s ease; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter.is-locked:hover .btn__label{ opacity:0; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter.is-locked::after{ content:'locked'; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); opacity:0; transition:opacity .2s ease; font-size:12px; letter-spacing:.06em; }
    #DropsCalendar-{{ section.id }} .btn.btn--enter.is-locked:hover::after{ opacity:1; }
  {% endstyle %}

  <script>
    (function(){
      var root = document.getElementById('DropsCalendar-{{ section.id }}');
      if(!root) return;
      var wrap = root.querySelector('.drop-cal');
      var timer = root.querySelector('[data-timer]');
      var btn = root.querySelector('[data-enter-btn]');
      var status = root.querySelector('[data-status] .label');
      var live = wrap.getAttribute('data-live') === 'true';

      function setNums(d,h,m,s){
        root.querySelector('[data-dd]').textContent = (d<10? ('0'+d): d);
        root.querySelector('[data-hh]').textContent = ('0'+h).slice(-2);
        root.querySelector('[data-mm]').textContent = ('0'+m).slice(-2);
        root.querySelector('[data-ss]').textContent = ('0'+s).slice(-2);
      }
      setNums(0,0,0,0);

      var Y = parseInt(timer.getAttribute('data-year'),10);
      var Mo = parseInt(timer.getAttribute('data-month'),10)-1;
      var D = parseInt(timer.getAttribute('data-day'),10);
      var H = parseInt(timer.getAttribute('data-hour'),10);
      var Mi = parseInt(timer.getAttribute('data-minute'),10);
      var target = new Date(Y,Mo,D,H,Mi,0).getTime();

      function unlock(){
        if(btn && btn.classList.contains('is-locked')){
          btn.classList.remove('is-locked');
          btn.setAttribute('href', {{ section.settings.enter_url | json }});
          if(status){ status.textContent = "DROP NOW LIVE: ‘{{ drop_name }}’"; }
        }
      }

      if(live){ unlock(); }
      else{
        var iv = setInterval(function(){
          var now = Date.now();
          var diff = Math.max(0, target - now);
          var d = Math.floor(diff/86400000);
          var h = Math.floor((diff%86400000)/3600000);
          var m = Math.floor((diff%3600000)/60000);
          var s = Math.floor((diff%60000)/1000);
          setNums(d,h,m,s);
          if(diff <= 0){ clearInterval(iv); setNums(0,0,0,0); unlock(); }
        }, 1000);
      }
    })();
  </script>
</section>

{% schema %}
