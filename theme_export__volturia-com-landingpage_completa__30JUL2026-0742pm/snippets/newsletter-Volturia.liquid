<style>
  /* Animations */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  
  /* Container principale */
  .newsletter-container {
    max-width: 400px;
    margin: 2rem auto;
    padding: 2rem;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    border-radius: 100px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2), inset 0 0 5px rgba(255,255,255,0.5);
    text-align: center;
    animation: fadeInUp 1s ease both;
    box-sizing: border-box;
  }
  .newsletter-container h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }
  /* Input email */
  #newsletter-form input[type="email"] {
    width: 100%;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border: none;
    border-radius: 50px;
    background: rgba(255,255,255,0.7);
    font-size: 1rem;
    box-sizing: border-box;
  }
  /* Container per telefono */
  .phone-container {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 1rem;
  }
  /* Dropdown Wrapper: larghezza fissa */
  .dropdown-wrapper {
    width: 150px;
    position: relative;
    box-sizing: border-box;
  }
  /* Custom Dropdown */
  .custom-dropdown {
    width: 100%;
    background: #fff; /* sfondo opaco al 100% */
    border-radius: 50px 0px 0px 50px;
    padding: 0.75rem 0.5rem;
    font-size: 1rem;
    cursor: pointer;
    box-sizing: border-box;
  }
  .custom-dropdown .selected-option {
    width: 100%;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .custom-dropdown .options {
    display: none;
    position: absolute;
    top: 100%;
    left: -200px;  /* Sposta il dropdown verso sinistra per maggior spazio */
    right: 0;
    background: #fff;
    border-radius: 0px;
    max-height: 200px; /* circa 8 opzioni */
    overflow-y: auto;
    overflow-x: hidden; /* evita lo scroll orizzontale */
    z-index: 10;
    animation: fadeInDown 0.5s ease both;
    box-sizing: border-box;
  }
  .custom-dropdown .option {
    padding: 0.5rem;
    cursor: pointer;
    white-space: nowrap;
    text-align: left;
  }
  .custom-dropdown .option:hover {
    background: rgba(0,0,0,0.1);
  }
  /* Input per il telefono: occupa il resto dello spazio */
  .phone-container input[type="tel"] {
    flex: 1;
    border: none;
    border-radius: 0 50px 50px 0;
    background: rgba(255,255,255,0.7);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    outline: none;
    box-sizing: border-box;
  }
  /* Bottone Subscribe */
  #newsletter-form button {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.3s ease;
    box-sizing: border-box;
  }
  #newsletter-form button:hover {
    background: #555;
  }
  /* Disclaimer */
  #newsletter-form small {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: #333;
    box-sizing: border-box;
  }
</style>

<script>
  // Gestione del dropdown custom
  const customDropdown = document.getElementById('customDropdown');
  const dropdownOptions = document.getElementById('dropdownOptions');
  const countryCodeInput = document.getElementById('countryCode');

  customDropdown.addEventListener('click', function(e) {
    e.stopPropagation();
    // Toggle visibilità opzioni
    dropdownOptions.style.display = dropdownOptions.style.display === "block" ? "none" : "block";
  });
  
  // Aggiorna la selezione quando si clicca su un'opzione
  const options = dropdownOptions.querySelectorAll('.option');
  options.forEach(function(option) {
    option.addEventListener('click', function(e) {
      const value = this.getAttribute('data-value');
      // Mostra solo il prefisso invece del testo completo
      customDropdown.querySelector('.selected-option').textContent = value;
      countryCodeInput.value = value;
      dropdownOptions.style.display = "none";
      e.stopPropagation();
    });
  });
  
  // Chiude il dropdown cliccando fuori
  document.addEventListener('click', function() {
    dropdownOptions.style.display = "none";
  });
  
  // Al submit, concatena il prefisso selezionato al numero di telefono
  document.getElementById('newsletter-form').addEventListener('submit', function(e) {
    var countryPrefix = countryCodeInput.value;
    var phoneInput = this.querySelector('input[name="contact[phone]"]');
    if (phoneInput.value.trim() !== "") {
      phoneInput.value = countryPrefix + " " + phoneInput.value;
    }
  });
</script>
